.env
.env.local
.env.*.local
# Staging (v0.6) — the real staging env (with a real JWT secret) is
# NEVER committed; only .env.staging.example is tracked.
.env.staging
# Staging runtime data (users, audit, conversations, vector store).
data-staging/
# Production (v0.8) — the real production env (with a real JWT secret)
# is NEVER committed; only .env.production.example is tracked.
.env.production
# Production runtime data (users, audit, conversations, vector store).
data-prod/
# Production backups (users + audit + vector store — keep off git).
backups/
# Production frontend build output (dev dist/ stays untouched).
frontend/dist-production/
# Staging frontend build output (dev dist/ stays untouched).
frontend/dist-staging/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
node_modules/
frontend/dist/
frontend/node_modules/
*.db
*.sqlite3
data/*.pdf
data/*.docx
data/*.xlsx
# Sprint 1 synthetic docs ARE tracked — they are fictional, created by us.
!data/docs/*.pdf
!data/docs_src/*.md
.DS_Store
# Local vector store / caches — regenerated by scripts/index_chunks.py
data/vector_store/
# Sprint 2 chat logs — local conversation history, never shipped in the zip
data/conversations.jsonl
# Sprint 3 — user store, audit log, refresh-token bookkeeping (local secrets/logs)
data/users.json
data/audit.jsonl
data/refresh_tokens.json
data/token_denylist.json
# Monitoring (v0.9) — recorded metrics, alerts, reports, archives (local runtime data)
data/metrics.jsonl
data/alerts.jsonl
data/reports/
data/archives/
rtb-venv/
.venv-sprint1/
.venv-sprint3/
