# PRODUCTION — Riyadh Trust Bank Enterprise Intelligence Platform (v0.8)
#
# Copy to .env.production and NEVER commit that file (it holds the real
# JWT secret — see .gitignore). The production setup script does this
# for you and generates a fresh secret on first run.
#
# Production = local production on Fahad's PC: same code, production
# mode, API :8000, web :3000, data in data-prod/. No Docker, no cloud,
# no public URL, no real users until the admin creates them.
# The app REFUSES TO START in production if SECRET_KEY is weak or
# CORS allows "*" (fail-fast — see backend/app/core/config.py).

ENVIRONMENT=production

# Production JWT secret — the setup script replaces the placeholder
# with a random value in .env.production. Generate one by hand with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# At least 32 random characters; never reuse the staging/dev secret.
SECRET_KEY=REPLACE-ME-WITH-A-LONG-RANDOM-SECRET

# Demo accounts are OFF in production (0). Do NOT set this to 1 in
# production — the demo passwords are public (docs) and anyone could
# log in as Admin. The first admin is created with
# scripts/create_admin.py after setup.
RTB_DEMO_ACCOUNTS=0

# Production runtime data (users, audit log, conversations, vector
# store). Relative to the project root; the app resolves it via
# RTB_DATA_DIR. Dev uses data/, staging uses data-staging/ — production
# NEVER touches either.
RTB_DATA_DIR=data-prod

# Production database: a SEPARATE SQLite file (relative to the backend/
# directory, where uvicorn runs). NOTE: like dev/staging, the SQLite
# file is currently inert — init_db() is only called for Postgres
# paths; the real stores are JSONL files in data-prod/. See
# docs/PRODUCTION.md § "PC-only items" for the PgVector test.
DATABASE_URL="sqlite:///./rtb_intelligence_prod.db"

# The built production frontend (localhost:3000) calls the API
# directly. ONLY this origin — no wildcard, no other ports.
CORS_ORIGINS=http://localhost:3000

# Reranker: "auto" = cross-encoder when cached/requested (Sprint 2
# rule), "off" = score rerank only. To test English latency on the PC
# without the cross-encoder, set this to "off", restart the API and
# ask the same English questions again — see docs/PRODUCTION.md.
RTB_RERANKER=auto

# OPTIONAL — Ollama for real LLM answers (Windows installer, no Docker).
# Leave commented out until Ollama + llama3.1:8b are installed on the
# PC; without it answers run in extractive-fallback mode (the response
# says which mode was used).
# OLLAMA_HOST=http://127.0.0.1:11434

# OPTIONAL — local PostgreSQL production DB on Fahad's PC (port 5432).
# Create it once: createdb rtb_intelligence_prod
# Then uncomment the line below (and comment the SQLite line out).
# DATABASE_URL=<redacted>
