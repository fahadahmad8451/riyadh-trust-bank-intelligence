# STAGING — Riyadh Trust Bank Enterprise Intelligence Platform (v0.6)
#
# Copy to .env.staging and NEVER commit that file (it holds a real
# secret — see .gitignore). The staging setup scripts do this for you
# and generate a fresh JWT secret on first run.
#
# Staging mirrors production as closely as possible, locally, $0:
# same code, separate ports, separate data, DEBUG off. No Docker, no
# cloud, no public URL, no real users — demo accounts only.

ENVIRONMENT=staging

# Fresh JWT secret — the setup script replaces the placeholder with
# a random value in .env.staging. Never put a real secret in this file.
SECRET_KEY=REPLACE-ME-WITH-A-LONG-RANDOM-SECRET

# Staging runtime data (users, audit log, conversations, vector store).
# Relative to the project root; the app resolves it via RTB_DATA_DIR.
# Dev keeps using data/ — staging NEVER touches dev data.
RTB_DATA_DIR=data-staging

# Staging database: a SEPARATE SQLite file (relative to the backend/
# directory, where uvicorn runs). Dev uses rtb_intelligence.db.
DATABASE_URL=sqlite:///./rtb_intelligence_staging.db

# The built staging frontend (localhost:3001) calls the API directly.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OPTIONAL — local PostgreSQL staging DB on Fahad's PC (port 5432).
# Create it once: createdb rtb_intelligence_staging
# Then uncomment the line below (and comment the SQLite line out).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rtb_intelligence_staging

# OPTIONAL — Ollama for real LLM answers (Windows installer, no Docker).
# OLLAMA_HOST=http://127.0.0.1:11434
