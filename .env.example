# Copy to .env — NEVER commit a real .env (see .gitignore)
# DOCKER NAHI CHAHIYE — local Windows setup, no Docker.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-secret-before-any-real-use

# Local PostgreSQL on Fahad's PC (port 5432 already open).
# Create the database once:  createdb rtb_intelligence   (or via pgAdmin)
# If PostgreSQL is not running, Setup still works — the DB is wired in Sprint 1,
# and the skeleton falls back to a local SQLite file (see app/core/config.py).
DATABASE_URL=postgresql://localhost:5432/rtb_intelligence

# OPTIONAL — leave empty in Setup. Redis/Celery are optional; backend runs without them.
REDIS_URL=
# OPTIONAL — Ollama (Windows installer, no Docker). Leave empty in Setup.
OLLAMA_HOST=
